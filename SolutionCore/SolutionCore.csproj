<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net8.0-android</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.MediaPipe</PackageId>
		<PackageVersion>0.10.20.1</PackageVersion>
		<AssemblyVersion>0.10.20.1</AssemblyVersion>
		<FileVersion>0.10.20.1</FileVersion>
		<Version>0.10.20.1</Version>
		<Title>Anjo Android MediaPipe SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.MediaPipe</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - The MediaPipe Android solution core components SDK</Description>
		<PackageReleaseNotes>The MediaPipe Android solution core components SDK v0.10.20</PackageReleaseNotes>
		<Copyright>Copyright (c) 2025 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, NET MAUI, MediaPipe, com.google.mediapipe, face-filters </PackageTags>
		<Summary>MediaPipe Solutions provides a suite of libraries and tools for you to quickly apply artificial intelligence (AI) and machine learning (ML) techniques in your applications. You can plug these solutions into your applications immediately, customize them to your needs, and use them across multiple development platforms. </Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="Jars\solution-core-0.10.20.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.1.0" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.1.0" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.1.0" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.1.0" />
		<PackageReference Include="Xamarin.Flogger" Version="0.8.0.5" />
		<PackageReference Include="Xamarin.Flogger.SystemBackend" Version="0.8.0.5" />
		<PackageReference Include="Xamarin.Google.Android.DataTransport.TransportApi" Version="3.2.0" />
		<PackageReference Include="Xamarin.Google.Android.DataTransport.TransportBackendCct" Version="3.2.0" />
		<PackageReference Include="Xamarin.Google.Android.DataTransport.TransportRuntime" Version="3.2.0" />
		<PackageReference Include="Xamarin.Google.Guava" Version="33.2.1.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.0.0.1" />
		<PackageReference Include="Xamarin.Protobuf.JavaLite" Version="4.26.1" />
	</ItemGroup>
</Project>